{
  "name": "amari-examples-suite",
  "version": "0.19.1",
  "description": "Interactive API examples for the Amari Mathematical Computing Library",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "preview:netlify": "npm run build && netlify deploy --dir=dist"
  },
  "dependencies": {
    "@justinelliottcobb/amari-wasm": "latest",
    "@mantine/code-highlight": "^8.3.16",
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "shiki": "^3.4.2",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.0.1",
    "react-router-dom": "^7.14.2",
    "typescript": "^5.1.6",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^4.0.16",
    "@webgpu/types": "^0.1.65",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.3.0",
    "netlify-cli": "^17.0.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
